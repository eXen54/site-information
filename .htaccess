RewriteEngine On
RewriteBase /site-information/

# Preserve existing files and folders.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Hardcoded SEO mapping: article slug -> numeric article path.
RewriteRule ^origines-conflit/?$ frontoffice/detail-article.php?id=1 [L,QSA,NC]

